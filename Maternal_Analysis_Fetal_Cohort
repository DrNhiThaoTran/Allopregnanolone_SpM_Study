> 
> variables <- c(
+   "Dam_weight",
+   "Litter_Size",
+   "Ovary_weight",
+   "Brain_weight",
+   "Brain_Body_Ratio"
+ )
> 
> 
> # Convert dependent variables to numeric
> Maternal_Fetal_Cohort[variables] <- lapply(Maternal_Fetal_Cohort[variables], function(x) {
+   as.numeric(as.character(x))
+ })
> 
> # Convert independent variable to factor
> Maternal_Fetal_Cohort$Group <- as.factor(Maternal_Fetal_Cohort$Group)
> 
> 
> 
> # Perform Shapiro-Wilk test for each variable within each group
> normality_results <- Maternal_Fetal_Cohort %>%
+   pivot_longer(
+     cols = all_of(variables),
+     names_to = "Variable",
+     values_to = "Value"
+   ) %>%
+   group_by(Variable, Group) %>%
+   summarise(
+     n = sum(!is.na(Value)),
+     W = shapiro.test(Value)$statistic,
+     p_value = shapiro.test(Value)$p.value,
+     .groups = "drop"
+   ) %>%
+   mutate(
+     Normality = ifelse(
+       p_value < 0.05,
+       "Significant departure from normality",
+       "No significant departure from normality"
+     )
+   )
