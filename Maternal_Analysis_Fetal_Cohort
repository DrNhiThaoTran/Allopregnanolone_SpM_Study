> # Perform Levene's test for each variable
> variance_results <- Maternal_Fetal_Cohort %>%
+   pivot_longer(
+     cols = all_of(variables),
+     names_to = "Variable",
+     values_to = "Value"
+   ) %>%
+   group_by(Variable) %>%
+   group_modify(~ {
+     test <- car::leveneTest(
+       Value ~ Group,
+       data = .x,
+       center = median
+     )
+     
+     tibble(
+       F_statistic = test[1, "F value"],
+       df1 = test[1, "Df"],
+       df2 = test[2, "Df"],
+       p_value = test[1, "Pr(>F)"]
+     )
+   }) %>%
+   ungroup() %>%
+   mutate(
+     Homogeneity = ifelse(
+       p_value < 0.05,
+       "Unequal variances",
+       "No evidence of unequal variances"
+     )
+   )
> 
